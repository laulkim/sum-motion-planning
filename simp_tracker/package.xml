<?xml version="1.0"?>
<package format="3">
  <name>simp_tracker</name>
  <version>0.1.0</version>
  <description>Python prototype of omnidirectional trajectory tracking.</description>
  <maintainer email="ske03005@cbnu.ac.kr">Jaepoong Lee</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>simp_planner_msgs</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
