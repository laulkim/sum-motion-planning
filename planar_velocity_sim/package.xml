<?xml version="1.0"?>
<package format="3">
  <name>planar_velocity_sim</name>
  <version>0.0.1</version>
  <description>Minimal planar simulator driven by body-frame vx, vy, and yaw rate.</description>

  <maintainer email="ske03005@cbnu.ac.kr">Jaepoong Lee</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>simp_planner_msgs</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
