<launch>
  <arg name="use_sim_time" default="false" />
  <node pkg="simp_tracker" exec="tracker_node" name="simp_tracker" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)" />
  </node>
  <arg name="costmap_update_period_sec" default="0.20" />
  <node
    pkg="simp_planner_cpp"
    exec="planner_node_cpp"
    name="planner_node"
    output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)" />
    <param
      name="costmap_update_period_sec"
      value="$(var costmap_update_period_sec)" />
  </node>
</launch>
